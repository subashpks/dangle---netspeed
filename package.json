{
  "name": "lucky-dangle",
  "version": "1.0.0",
  "description": "A delightful physics-based desktop cultural charm dangle",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:mac:arm": "electron-builder --mac dmg --arm64",
    "build:mac:intel": "electron-builder --mac dmg --x64",
    "build:mac:universal": "electron-builder --mac dmg --universal",
    "build:win": "electron-builder --win nsis --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:linux:all": "electron-builder --linux AppImage deb rpm --x64 --arm64",
    "build:android": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:all": "npm run build:mac:universal && npm run build:win && npm run build:linux"
  },
  "keywords": [
    "macos",
    "windows",
    "linux",
    "menubar",
    "electron",
    "matterjs",
    "lucky-charm",
    "dangle"
  ],
  "author": "Lucky Dangle Team <support@luckydangle.app>",
  "license": "MIT",
  "dependencies": {
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luckydangle.app",
    "productName": "Lucky Dangle",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "backgroundColor": "#1a1a1a"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Desktop Cultural Charm Dangle",
      "description": "A delightful physics-based desktop cultural charm dangle",
      "desktop": {
        "Name": "Lucky Dangle",
        "Comment": "A delightful physics-based desktop cultural charm dangle",
        "Categories": "Utility;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    }
  }
}
